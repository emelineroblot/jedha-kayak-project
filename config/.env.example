# ═══════════════════════════════════════════════════════════════════════
# Template des variables d'environnement — Projet Kayak
#
# Copier ce fichier en config/.env puis renseigner les valeurs.
#   cp config/.env.example config/.env
#
# Les notebooks et les scripts chargent ce fichier via load_dotenv('../config/.env').
# config/.env est ignoré par Git : aucun secret ne doit être commité.
# ═══════════════════════════════════════════════════════════════════════

# ── Météo — notebook 02_data_weather.ipynb ────────────────────────────
# Clé gratuite : https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ── Scraping Booking.com — src/trigger_scraping.py, src/fetch_results.py ──
# Jeton d'API BrightData (dataset Booking.com)
BRIGHTDATA_API_KEY=

# ── AWS — notebooks 08_aws_setup, 09_deploy_s3, 11_import_data_rds ────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=

# ── PostgreSQL sur AWS RDS — notebooks 10_setup_rds, 11_import_data_rds ──
DB_HOST=
DB_PORT=5432
DB_NAME=kayak
DB_USER=postgres
DB_PASSWORD=
